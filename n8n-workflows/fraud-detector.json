      "parameters": {
        "jsCode": "const body = $('Webhook').first().json.body;\nconst amount = Number(body.amount);\nconst recentCount = Number($input.first().json.recent_count);\n\nlet decision = \"COMPLETED\";\nlet reason = \"Looks normal\";\n\nif (recentCount >= 4) {\n  decision = \"BLOCKED\";\n  reason = \"Too many transfers in 1 minute: \" + (recentCount + 1);\n} else if (recentCount >= 2) {\n  decision = \"FLAGGED\";\n  reason = \"Rapid transfers in 1 minute: \" + (recentCount + 1);\n} else if (amount >= 800) {\n  decision = \"FLAGGED\";\n  reason = \"Large amount: \" + amount;\n}\n\nreturn [{ json: { decision, reason } }];"
      },
