    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COUNT(*) AS recent_count\nFROM transactions t\nJOIN wallets w ON w.id = t.sender_wallet_id\nJOIN users u ON u.id = w.user_id\nWHERE u.email = $1\n  AND t.created_at > NOW() - INTERVAL '1 minute';",
        "options": {
          "queryReplacement": "={{ $json.body.senderEmail }}"
        }
      },
