# Copy this file to ".env" and replace the placeholder values.
# NEVER commit the real .env file.

# Password for the PostgreSQL user wallet_admin
DB_PASSWORD=change-me

# Secret used to sign login tokens (JWT). Use a long random string, 32+ characters.
JWT_SECRET=change-me-to-a-long-random-string

# Shared secret sent in the X-Webhook-Secret header to the n8n webhooks.
# Must be the same value stored in the n8n "SecureWallet Webhook Secret" credential.
N8N_WEBHOOK_SECRET=change-me-to-a-long-random-string